APP_NAME="Techlo Post"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=just_one_post
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---- Just One Post ----
# Time zone used to display/enter dates in the UI. Everything is stored in UTC.
DISPLAY_TIMEZONE=Asia/Dhaka
# Public base URL used to build media URLs for Instagram (must be reachable from the internet).
# Leave blank to fall back to APP_URL. Locally set this to your ngrok/cloudflared URL.
PUBLIC_BASE_URL=
# Graph API version for Facebook/Instagram and LinkedIn-Version header (YYYYMM).
META_GRAPH_VERSION=v25.0
LINKEDIN_API_VERSION=202609
# Optional: absolute path to ffprobe for video duration/aspect validation (skipped if empty).
FFPROBE_PATH=
# Seconds a queued job may run before another worker may re-grab it (video uploads are slow).
QUEUE_RETRY_AFTER=1800

# LinkedIn (https://www.linkedin.com/developers/apps) - products: "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect"
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI="${APP_URL}/connections/linkedin/callback"

# Meta (https://developers.facebook.com/apps) - Facebook Login + Instagram content publishing
FACEBOOK_CLIENT_ID=your-meta-app-id
FACEBOOK_CLIENT_SECRET=your-meta-app-secret
FACEBOOK_REDIRECT_URI="${APP_URL}/connections/facebook/callback"

# Google Cloud (https://console.cloud.google.com) - YouTube Data API v3 OAuth client (Web application)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI="${APP_URL}/connections/youtube/callback"

# Threads (Meta app -> Threads use case -> Settings): the Threads App ID/Secret, NOT the Facebook ones
THREADS_CLIENT_ID=your-threads-app-id
THREADS_CLIENT_SECRET=your-threads-app-secret
THREADS_REDIRECT_URI="${APP_URL}/connections/threads/callback"

# X / Twitter (developer.x.com -> your app -> OAuth 2.0 Client ID and Secret). X's API is pay-per-use.
X_CLIENT_ID=your-x-client-id
X_CLIENT_SECRET=your-x-client-secret
X_REDIRECT_URI="${APP_URL}/connections/x/callback"

# Telegram, Discord and WordPress need no keys here: connect them from the Connections page.
